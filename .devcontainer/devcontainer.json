{
  "name": "Forecasting - Codespaces",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/codespace/.local/bin/python",
        "python.terminal.activateEnvironment": false
      }
    }
  },
  "postCreateCommand": "pip install --user -r requirements.txt && python -m ipykernel install --user --name forecasting --display-name \"Python (Forecasting)\"",
  "forwardPorts": [8888],
  "remoteUser": "codespace"
}
